# Copy to .env and fill in. Never commit .env.

# --- Local detector (OpenAI-compatible server on this machine, e.g. llama.cpp llama-server) ---
AIRLOCK_LOCAL_BASE_URL=http://127.0.0.1:8081/v1
AIRLOCK_LOCAL_MODEL=nemotron-3-nano-4b
# Optional: bearer key if your local server requires one
AIRLOCK_LOCAL_API_KEY=
# Send chat_template_kwargs.enable_thinking=false with every detector call (true/false)
AIRLOCK_LOCAL_DISABLE_THINKING=true
AIRLOCK_LOCAL_TIMEOUT_S=60

# --- Upstream: Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
AIRLOCK_UPSTREAM_BASE_URL=https://api.tokenfactory.nebius.com/v1
AIRLOCK_UPSTREAM_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Retried once if the primary model returns 5xx or is unavailable. Empty = no fallback.
AIRLOCK_UPSTREAM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
AIRLOCK_UPSTREAM_TIMEOUT_S=120

# --- Private web search ---
TAVILY_API_KEY=
AIRLOCK_TAVILY_BASE_URL=https://api.tavily.com

# --- Local state (both files stay on this machine) ---
AIRLOCK_VAULT_PATH=./.airlock/vault.sqlite3
AIRLOCK_AUDIT_DB=./.airlock/audit.sqlite3
# Audit records hash sensitive values with HMAC-SHA256 under this key. Leave empty to have
# Airlock generate one at AIRLOCK_AUDIT_HASH_KEY_FILE (mode 600) on first start.
AIRLOCK_AUDIT_HASH_KEY=
AIRLOCK_AUDIT_HASH_KEY_FILE=./.airlock/audit_hash.key

# strict | balanced | minimal  (how aggressively quasi-identifiers are generalized)
AIRLOCK_PROTECTION_LEVEL=balanced

# Comma-separated canary strings: if one ever reaches an outbound payload, the request is blocked
AIRLOCK_CANARIES=

# Server bind address (keep it on loopback)
AIRLOCK_HOST=127.0.0.1
AIRLOCK_PORT=8787
# Host headers accepted (protects the local API from DNS rebinding). "*" disables the check.
AIRLOCK_ALLOWED_HOSTS=127.0.0.1,localhost,::1
