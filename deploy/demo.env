# Non-secret settings for the hosted demo, shared by Option A (Nebius) and Option B (Fly.io).
# Secrets (NEBIUS_API_KEY, TAVILY_API_KEY) are NEVER put here: they go to the platform's secret store.
# One KEY=VALUE per line, no quotes, no inline comments.

AIRLOCK_DEMO=1
AIRLOCK_DETECTOR_BACKEND=cloud
AIRLOCK_CLOUD_DETECTOR_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
AIRLOCK_UPSTREAM_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
AIRLOCK_UPSTREAM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
AIRLOCK_PROTECTION_LEVEL=balanced
AIRLOCK_AGENT_MAX_STEPS=6

# Abuse and cost guards. See deploy/DEMO_RUNBOOK.md "Cost model" before raising them.
AIRLOCK_DEMO_IP_LIMIT=20
AIRLOCK_DEMO_SESSION_LIMIT=20
AIRLOCK_DEMO_WINDOW_S=600
AIRLOCK_DEMO_MAX_INPUT_CHARS=4000
AIRLOCK_DEMO_MAX_TOKENS=1024
AIRLOCK_DEMO_DAILY_REQUESTS=300
AIRLOCK_DEMO_DAILY_CLOUD_CALLS=1200
AIRLOCK_DEMO_SESSION_TTL_S=1800
AIRLOCK_DEMO_PRESETS=auto
